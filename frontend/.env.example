# BeeBox Identity service (server-side only)
# Point this to your running beebox-identity (default port 8081)
BEEBOX_IDENTITY_URL=http://127.0.0.1:8081

# Optional project context (server-side only — never expose to browser)
# BEEBOX_PROJECT_ID=
# BEEBOX_PROJECT_CREDENTIAL=

# Session cookie
SESSION_COOKIE_NAME=beebox_session
# Set to true in production behind HTTPS
SESSION_COOKIE_SECURE=false
